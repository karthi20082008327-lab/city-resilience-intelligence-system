# Docker Compose environment template.
# Copy to `.env` in this directory and fill in real values for production.
# Compose reads `./.env` here for variable substitution.

POSTGRES_USER=ucrip
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=ucrip_db

# Backend secrets — MUST be changed in production.
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_REFRESH_SECRET_KEY=change-me-in-production