{
  "name": "ucrip-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@heroui/react": "^2.6.14",
    "@heroui/theme": "^2.4.14",
    "@tanstack/react-query": "^5.59.0",
