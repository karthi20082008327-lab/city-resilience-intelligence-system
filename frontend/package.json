    "@tensorflow/tfjs": "^4.22.0",
    "axios": "^1.7.8",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
